{
  "name": "remotionprojectmanager",
  "productName": "Remotion 工程管家",
  "version": "1.0.3",
  "description": "Windows desktop manager for persistent Remotion projects",
  "main": ".vite/build/index.js",
  "private": true,
  "author": "Xu Shuai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuguohua318/remotion-project-manager.git"
  },
  "homepage": "https://github.com/xuguohua318/remotion-project-manager#readme",
  "bugs": {
    "url": "https://github.com/xuguohua318/remotion-project-manager/issues"
  },
  "keywords": [
    "remotion",
    "electron",
    "video",
    "keyframes",
    "windows"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron-forge start",
    "build": "vite build --config vite.renderer.config.ts && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/prepare-build-tools.cjs && electron-forge package",
    "make": "node scripts/prepare-build-tools.cjs && electron-forge package && node scripts/make-distributables.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@electron-forge/shared-types": "^7.8.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.1.2",
    "grunt-nuget-pack": "^1.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
